diff --git a/inference/src/translator/translation_model.cpp b/inference/src/translator/translation_model.cpp
--- a/inference/src/translator/translation_model.cpp
+++ b/inference/src/translator/translation_model.cpp
@@ -219,6 +219,9 @@
   auto &backend = backend_[deviceId];
 
   if (!backend.initialized) {
+    // Workers build their backend on first use, concurrently; loadBackend reads and
+    // clones the shared Options (not thread-safe, see common/options.h), so one at a time.
+    std::lock_guard<std::mutex> lock(backendInitMutex_);
     loadBackend(deviceId);
     backend.initialized = true;
   }
